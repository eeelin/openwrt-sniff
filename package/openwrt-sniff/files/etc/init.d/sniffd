#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

append_interface() {
	local value="$1"
	[ -n "$value" ] || return 0
	if [ -n "$capture_interfaces" ]; then
		capture_interfaces="$capture_interfaces,$value"
	else
		capture_interfaces="$value"
	fi
}

append_lan_prefix() {
	local value="$1"
	[ -n "$value" ] || return 0
	if [ -n "$lan_prefixes" ]; then
		lan_prefixes="$lan_prefixes,$value"
	else
		lan_prefixes="$value"
	fi
}

append_nft_set() {
	local value="$1"
	[ -n "$value" ] || return 0
	if [ -n "$nft_sets" ]; then nft_sets="$nft_sets,$value"; else nft_sets="$value"; fi
}

start_service() {
	local enabled listen window max_flows max_stream_bytes
	capture_interfaces=''
	lan_prefixes=''
	nft_sets=''
	config_load sniffd
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get listen main listen '0.0.0.0:8088'
	config_get window main window '5m'
	config_get max_flows main max_flows '4096'
	config_get max_stream_bytes main max_stream_bytes '16384'
	config_list_foreach main interface append_interface
	config_list_foreach main lan_prefix append_lan_prefix
	config_list_foreach main nft_set append_nft_set
	[ -n "$capture_interfaces" ] || capture_interfaces='br-lan'

	procd_open_instance
	procd_set_param command /usr/bin/sniffd
	procd_append_param command -listen "$listen"
	procd_append_param command -interfaces "$capture_interfaces"
	[ -z "$lan_prefixes" ] || procd_append_param command -lan-prefixes "$lan_prefixes"
	[ -z "$nft_sets" ] || procd_append_param command -nft-sets "$nft_sets"
	procd_append_param command -window "$window"
	procd_append_param command -max-flows "$max_flows"
	procd_append_param command -max-stream-bytes "$max_stream_bytes"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 5
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger sniffd
}
